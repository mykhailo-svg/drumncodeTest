<style>
  .ep-section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px;
    box-sizing: border-box;
  }
  .ep-grid {
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }
  .ep-left,
  .ep-right {
    box-sizing: border-box;
  }
  .ep-left {
    flex: 1 1 50%;
  }
  .ep-right {
    flex: 1 1 50%;
  }
  .ep-image {
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
  }
  .ep-image img {
    width: 100%;
    height: auto;
    display: block;
  }
  .ep-title {
    font-size: 24px;
    margin: 0 0 8px;
  }
  .ep-description {
    margin: 0 0 12px;
    line-height: 1.4;
  }
  .ep-price {
    font-size: 20px;
    font-weight: 600;
    margin: 8px 0 12px;
  }
  .ep-selectors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 12px;
  }
  .ep-select {
    display: flex;
    flex-direction: column;
  }
  .ep-select label {
    font-size: 13px;
    margin-bottom: 4px;
  }
  .ep-select select,
  .ep-input input,
  .ep-input select {
    padding: 8px;
    border-radius: 6px;
    border: 1px solid #ccc;
  }
  .ep-cta {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 12px;
  }
  .ep-button {
    padding: 12px 18px;
    border-radius: 8px;
    background: #0a6;
    color: #fff;
    border: none;
    cursor: pointer;
    font-weight: 600;
  }
  .ep-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .ep-form {
    margin-top: 16px;
    display: grid;
    gap: 8px;
  }
  .ep-form .ep-row {
    display: flex;
    gap: 8px;
  }
  .ep-form label {
    font-size: 12px;
    margin-bottom: 4px;
  }
  .ep-note {
    font-size: 12px;
    color: #666;
    margin-top: 8px;
  }
  .ep-hidden {
    display: none;
  }
</style>

<section id="ep-event-product-section" class="ep-section" data-product-id="{{ product.id }}">
  <div class="ep-grid">
    <div class="ep-left">
      <div class="ep-image">
        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | img_url: '1024x1024' }}"
            alt="{{ product.featured_image.alt | escape }}"
          >
        {% elsif product.images.size > 0 %}
          <img src="{{ product.images.first | img_url: '1024x1024' }}" alt="{{ product.title | escape }}">
        {% else %}
          <div style="background:#f4f4f4;height:320px;display:flex;align-items:center;justify-content:center;color:#999;">
            No image
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ep-right">
      <h1 class="ep-title">{{ product.title }}</h1>
      <div class="ep-description">{{ product.description | strip_html | truncate: 400 }}</div>

      <div class="ep-price" id="ep-price">{{ product.price | money }}</div>

      <div class="ep-selectors" id="ep-selectors">
        {% for option in product.options_with_values %}
          <div class="ep-select" data-option-index="{{ forloop.index0 }}">
            <label for="ep-option-{{ forloop.index0 }}">{{ option.name }}</label>
            <select
              id="ep-option-{{ forloop.index0 }}"
              class="ep-option-select"
              data-option-name="{{ option.name | escape }}"
            >
              <option value="">— Оберіть {{ option.name }} —</option>
              {% for value in option.values %}
                <option value="{{ value | escape }}">{{ value }}</option>
              {% endfor %}
            </select>
          </div>
        {% endfor %}
      </div>

      <div class="ep-cta">
        <button id="ep-add-to-cart" class="ep-button" type="button">Перейти до чекауту</button>
        <div id="ep-variant-status" style="font-size:13px;color:#555;">&nbsp;</div>
      </div>

      <form id="ep-personal-form" class="ep-form" novalidate>
        <div class="ep-row">
          <div style="flex:1" class="ep-input">
            <label for="ep-first-name">Ім'я *</label>
            <input id="ep-first-name" name="first_name" type="text" required>
          </div>
          <div style="flex:1" class="ep-input">
            <label for="ep-last-name">Прізвище *</label>
            <input id="ep-last-name" name="last_name" type="text" required>
          </div>
        </div>
        <div class="ep-row">
          <div style="flex:1" class="ep-input">
            <label for="ep-email">Email *</label>
            <input id="ep-email" name="email" type="email" required>
          </div>
          <div style="flex:1" class="ep-input">
            <label for="ep-phone">Телефон *</label>
            <input id="ep-phone" name="phone" type="tel" required>
          </div>
        </div>
        <div class="ep-row">
          <div style="flex:1" class="ep-input">
            <label for="ep-postal">Поштовий код *</label>
            <input id="ep-postal" name="postal_code" type="text" required>
          </div>
          <div style="flex:1" class="ep-input">
            <label for="ep-dob">Дата народження *</label>
            <input id="ep-dob" name="dob" type="date" required>
          </div>
        </div>
        <div class="ep-row">
          <div style="flex:1" class="ep-input">
            <label for="ep-gender">Гендер *</label>
            <select id="ep-gender" name="gender" required>
              <option value="">— Оберіть —</option>
              <option value="female">Жіноча</option>
              <option value="male">Чоловіча</option>
              <option value="other">Інше</option>
              <option value="prefer_not">Не вказувати</option>
            </select>
          </div>
          <div style="flex:1" class="ep-input">
            <label for="ep-user-code">Код користувача (необов'язково)</label>
            <input id="ep-user-code" name="user_code" type="text">
          </div>
        </div>
        <div class="ep-note">Всі поля обов'язкові до заповнення, окрім коду користувача.</div>
      </form>
    </div>
  </div>
</section>

<script>
      window.addEventListener('DOMContentLoaded', function(){
        const product = {{ product | json }};
       
        const priceEl = document.getElementById('ep-price');
        const statusEl = document.getElementById('ep-variant-status');
        const selects = Array.from(document.querySelectorAll('.ep-option-select'));
        const addBtn = document.getElementById('ep-add-to-cart');
        const form = document.getElementById('ep-personal-form');

        function findVariant(values){
          return product.variants.find(v => v.options.every((opt,i) => opt === values[i]));
        }

       function formatMoney(cents) {

    const amount = cents / 100;

    return amount.toLocaleString(undefined, {
      style: 'currency',
      currency: '{{ shop.currency }}',
    });
  }

  function updatePriceAndStatus() {
    const values = selects.map(s => s.value || '');

    if (values.some(v => v === '')) {
      const basePrice = formatMoney(product.price_min || product.price);
     
      priceEl.textContent = basePrice;
      statusEl.textContent = 'Будь ласка, оберіть всі опції.';
      addBtn.disabled = true;
      return;
    }

    const variant = findVariant(values);

    if (!variant) {
      statusEl.textContent = 'Варіант недоступний.';
      addBtn.disabled = true;
      return;
    }

    priceEl.textContent = formatMoney(variant.price);
    statusEl.textContent = variant.available ? 'В наявності' : 'Немає в наявності';
    addBtn.disabled = !variant.available;
    addBtn.dataset.variantId = variant.id;
  }


        selects.forEach(s=> s.addEventListener('change', updatePriceAndStatus));

        const optionNames = product.options.map(o => o.toLowerCase());
        const codeIndex = optionNames.findIndex(n => n.includes('код') || n.includes('code') || n.includes('type')|| n.includes('код:'));
        const dateIndex = optionNames.findIndex(n => n.includes('дата') || n.includes('date') || n.includes('day'));
        const timeIndex = optionNames.findIndex(n => n.includes('час') || n.includes('time') || n.includes('hour'));

        function constrainDateTime(){
          if(codeIndex < 0 || dateIndex < 0 || timeIndex < 0) return;

          const codeSelect = document.querySelector('#ep-option-' + codeIndex);
          const dateSelect = document.querySelector('#ep-option-' + dateIndex);
          const timeSelect = document.querySelector('#ep-option-' + timeIndex);

          if(!codeSelect || !dateSelect || !timeSelect) return;

          const codeVal = codeSelect.value;
          const groupKeywords = ['груп', 'групові', 'занят'];
          const marathonKeywords = ['10', 'марафон', '10 км'];

          function containsAny(str, arr){ if(!str) return false; str = str.toLowerCase(); return arr.some(k=>str.includes(k)); }

          function filterOptions(selectEl, allowed){
            const current = selectEl.value;
            Array.from(selectEl.options).forEach(opt=>{
              if(opt.value === '' ) return;
              opt.disabled = !allowed.includes(opt.value);
            });
            if(current && !allowed.includes(current)) selectEl.value = '';
          }

          if(containsAny(codeVal, groupKeywords)){
            const allowedDates = Array.from(dateSelect.options).map(o=>o.value).filter(v => /31/.test(v) || v.includes('31'));
            const allowedTimes = Array.from(timeSelect.options).map(o=>o.value).filter(v => /(9:00|9:30|10:00|10:30|11:00)/.test(v));

            filterOptions(dateSelect, allowedDates);
            filterOptions(timeSelect, allowedTimes);
          } else if(containsAny(codeVal, marathonKeywords)){
            const allowedDates = Array.from(dateSelect.options).map(o=>o.value).filter(v => /30/.test(v) || v.includes('30'));
            const allowedTimes = Array.from(timeSelect.options).map(o=>o.value).filter(v => /(10:00|10:30|11:00|11:30|12:00|12:30)/.test(v));

            filterOptions(dateSelect, allowedDates);
            filterOptions(timeSelect, allowedTimes);
          } else {
            Array.from(dateSelect.options).forEach(o=> o.disabled = false);
            Array.from(timeSelect.options).forEach(o=> o.disabled = false);
          }
        }

        if(codeIndex >=0){
          const codeSel = document.querySelector('#ep-option-' + codeIndex);

          if(codeSel) codeSel.addEventListener('change', function(){ constrainDateTime(); updatePriceAndStatus(); });
        }

        updatePriceAndStatus();

        addBtn.addEventListener('click', function(){
          const values = selects.map(s=>s.value || '');

          if(values.some(v=>v==='')){ alert('Будь ласка, оберіть всі варіанти.'); return; }

          const variantId = addBtn.dataset.variantId;

          if(!variantId){ alert('Вибраний варіант недоступний.'); return; }

          const required = Array.from(form.querySelectorAll('[required]'));

          for(const el of required){ if(!el.value){ el.focus(); alert('Будь ласка заповніть всі обов\'язкові поля.'); return; } }

          const props = {};
          props['Ім\'я'] = document.getElementById('ep-first-name').value;
          props['Прізвище'] = document.getElementById('ep-last-name').value;
          props['Email'] = document.getElementById('ep-email').value;
          props['Телефон'] = document.getElementById('ep-phone').value;
          props['Поштовий код'] = document.getElementById('ep-postal').value;
          props['Дата народження'] = document.getElementById('ep-dob').value;
          props['Гендер'] = document.getElementById('ep-gender').value;

          const userCodeVal = document.getElementById('ep-user-code').value;
          if(userCodeVal) props['Код користувача'] = userCodeVal;

          product.options.forEach((optName, idx)=>{
            props['Вибір: ' + optName] = selects[idx] ? selects[idx].value : '';
          });

          const body = { id: variantId, quantity: 1, properties: props };
          addBtn.disabled = true;
          addBtn.textContent = 'Додаємо...';

          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
          })
          .then(r=> r.json())
          .then(data=>{
            window.location.href = '/checkout';
          })
          .catch(err=>{
            console.error(err);
            alert('Помилка при додаванні до кошика. Спробуйте ще раз.');
            addBtn.disabled = false;
            addBtn.textContent = 'Перейти до чекауту';
          });
        });

      });
</script>

{% schema %}
{
  "name": "event-product",
  "tag": "section",
  "settings": [],
  "blocks": [
    { "type": "image", "name": "Картинка (ліва)" },
    { "type": "title", "name": "Заголовок" },
    { "type": "description", "name": "Опис" },
    { "type": "price", "name": "Ціна" },
    { "type": "selectors", "name": "Селектори" },
    { "type": "cta", "name": "Кнопка" }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Event product section", "category": "Products" }]
}
{% endschema %}
